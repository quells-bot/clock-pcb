{
  "name": "clock-pcb",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "kicad:front": "tsci export front/front.circuit.tsx -f kicad_zip -o ../dist/front-kicad.zip",
    "kicad:brain": "tsci export back/brain.circuit.tsx -f kicad_zip -o ../dist/brain-kicad.zip",
    "kicad": "bun run kicad:front && bun run kicad:brain",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "tscircuit": "^0.0.3285",
    "typescript": "^5.0.0"
  }
}
